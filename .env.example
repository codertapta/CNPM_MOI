
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/cnpm_moi

# JWT signing secret
# Replace with a strong random secret for each environment
JWT_SECRET=replace_with_a_strong_random_secret

# Initial administrator account
# Use only for the initial admin bootstrap process
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_strong_password

# CORS allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Nearby POI search radius in meters
NEARBY_RADIUS_M=5000

# Directory for generated or uploaded audio files
AUDIO_DIR=./data/audio
